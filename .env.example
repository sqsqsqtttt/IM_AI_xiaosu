# ===== DeepSeek 对话模型（platform.deepseek.com 获取）=====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-v4-flash
# default  = 思考模式开启（官方默认，回答质量更高）；disabled = 关闭（更快更省，工具路由更稳）
LLM_THINKING=default

# ===== 嵌入模型（RAG 向量化，DeepSeek 无嵌入接口，故单独配置）=====
# local  = 本地 bge-small-zh-v1.5（默认，首次运行自动下载约 100MB，之后完全离线）
# remote = 远程 OpenAI 兼容嵌入接口（如硅基流动 bge-m3），填 EMBED_BASE_URL / EMBED_API_KEY
# fake   = 确定性假嵌入（仅供离线测试）
EMBED_PROVIDER=local
EMBED_MODEL=Xenova/bge-small-zh-v1.5
EMBED_BASE_URL=
EMBED_API_KEY=
# 国内镜像，huggingface.co 下载失败时使用
HF_ENDPOINT=https://hf-mirror.com

# ===== 钉钉机器人（Stream 模式，open.dingtalk.com 获取）=====
DINGTALK_ENABLED=false
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# ===== 服务 =====
PORT=3000
# 公网地址（部署后填写，用于 IM 里“查看原文”链接；本地演示留空则仅文本引用）
PUBLIC_BASE_URL=
# 数据与日志路径
DB_PATH=./data/xiaosu.db
LOG_DIR=./logs
